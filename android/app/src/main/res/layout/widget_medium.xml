<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <!-- The water, drawn by WaterRenderer. Tap to wake it. -->
    <ImageView
        android:id="@+id/water"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_water_description"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/open"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:alpha="0.75"
        android:contentDescription="@string/widget_open_description"
        android:padding="9dp"
        android:src="@drawable/ic_stat_waterly" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/add_first"
            style="@style/WidgetCupButton"
            android:text="+150" />

        <TextView
            android:id="@+id/add_second"
            style="@style/WidgetCupButton"
            android:layout_marginStart="8dp"
            android:text="+250" />
    </LinearLayout>
</FrameLayout>
